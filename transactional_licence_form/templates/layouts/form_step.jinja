{% extends "layouts/standard_content.jinja" %}
{% from "components/contents.jinja" import contents %}
{% from "components/list.jinja" import list, list_item %}
{% from "components/heading.jinja" import heading %}
{% block javascript %}
  <script type="module"
          defer
          src="{{ static('js/dist/transactional_licence_form.js') }}"></script>
  <script type="module" defer src="{{ static('js/dist/location_picker.js') }}"></script>
{% endblock javascript %}
{% block head %}
  {{ wizard.form.media }}
{% endblock head %}
{% block is_full_screen %}
  {% set mobile_article_title_content %}
    <div class="mobile-only">
      {% block mobile_article_title %}
      {% endblock mobile_article_title %}
    </div>
  {% endset %}
  {% call contents(
    title="Licence application steps",
    class_name="standard-content__navigation",
    links_class_name="standard-content__navigation-links",
    before_links=mobile_article_title_content
    ) %}
    {% call list() %}
      {% for steps in wizard.form.navigation_done %}{{ list_item(content=steps) }}{% endfor %}
      {% call list_item() %}
        <strong>{{ wizard.form.navigation_current }}</strong>
      {% endcall %}
      {% for steps in wizard.form.navigation_todo %}{{ list_item(content=steps) }}{% endfor %}
    {% endcall %}
  {% endcall %}
{% endblock is_full_screen %}
{% block article_content %}
  <div class="transactional-licence-form">
    {% block pre_title %}
    {% endblock pre_title %}
    {% block step_title %}
      <h1 class="transactional-licence-form__step-title">{{ wizard.form.title }}</h1>
    {% endblock step_title %}
    <div class="transactional-licence-form__pre-form-content">
      {% block pre_form %}
      {% endblock pre_form %}
    </div>
    <form action=""
          method="post"
          id="transactional-licence-form-form"
          novalidate>
      {{ csrf_input }}
      {{ wizard.management_form }}
      {% if wizard.form.forms %}{{ wizard.form.management_form }}{% endif %}
      {% block form_inner %}
        {% if reviewing %}<input type="hidden" name="reviewing" value="true" />{% endif %}
        {% if wizard.form.forms %}
          {% for form in wizard.form.forms %}<div>{{ crispy(form) }}</div>{% endfor %}
        {% else %}
          <div>{{ crispy(wizard.form) }}</div>
        {% endif %}
      {% endblock form_inner %}
      <div class="transactional-licence-form__actions">
        {% if wizard.steps.prev %}
          {% call button(
            variant="secondary",
            attrs={
            "name": "wizard_goto_step",
            "type": "button",
            "id": "transactional-licence-form-previous-button",
            "value": wizard.steps.prev
            }
            ) %}
            Previous
          {% endcall %}
          &nbsp;
        {% endif %}
        {{ button(variant=("secondary" if reviewing) , element_type="input", attrs={"type": "submit", "value": wizard.steps.current|submit_label_for_step}) }}
        {% if reviewing %}
          {% call button(
            attrs={
            "name": "wizard_goto_step",
            "type": "submit",
            "value": "review"
            }
            ) %}
            Save and review
          {% endcall %}
        {% endif %}
      </div>
    </form>
    {% block post_form %}
    {% endblock post_form %}
  </div>
{% endblock article_content %}
{% block end_of_document_marker %}
{% endblock end_of_document_marker %}

{% set id = widget.attrs.id %}
<div {% if id %}id="{{ id }}"{% endif %}
     {% if widget.attrs.class %}class="{{ widget.attrs.class }}"{% endif %}>
  {% for group, options, index in widget.optgroups %}
    <div data-court-group>
      {% if group %}
        <div class="structured-search__court-option">
          <label>
            <input type="checkbox"
                   data-group-toggle
                   hidden
                   aria-controls="{{ id }}_group_{{ index }}" />
            <span class="structured-search__court-option-label">{{ group }}</span>
          </label>
        </div>
        <div class="structured-search__court-group"
             id="{{ id }}_group_{{ index }}">
      {% endif %}
      {% for option in options %}
        {% set widget = dict(option, attrs=dict(option.attrs, checked=True)) if scope_selected|default(false) else option %}
        <div>{% include option.template_name %}</div>
      {% endfor %}
      {% if group %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>

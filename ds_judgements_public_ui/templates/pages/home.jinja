{% extends "layouts/base.jinja" %}
{% from "components/alert.jinja" import alert %}
{% from "components/aside.jinja" import aside, aside_container %}
{% from "components/button.jinja" import button %}
{% from "components/details.jinja" import details %}
{% from "components/card.jinja" import card %}
{% from "components/heading.jinja" import heading %}
{% from "components/content_container.jinja" import content_container %}
{% from "components/documents_table.jinja" import document_table_row, document_table_cell, documents_table, document_table_body %}
{% from "components/grid.jinja" import grid %}
{% from "components/hero.jinja" import hero %}
{% from "components/radios.jinja" import radios %}
{% from "components/search_input.jinja" import search_form,search_form_container, search_input, search_input_footer %}
{% from "components/tooltip.jinja" import tooltip %}
{% block content %}
  {% call hero(variant="light") %}
    {% call search_form(label="Search by keyword or neutral citation", id="analytics-search-form", method="post") %}
      {{ csrf_input }}
      <input type="hidden" name="save_search_scope_preference" value="1" />
      {% call search_form_container() %}
        {{ heading(tag="h2", content="What would you like to search?") }}
        <p>Choose which judgments and decisions to include in your search.</p>
        {{ radios({
          "idPrefix": "scope",
          "name": "scope",
          "formGroup": {
            "classes": "govuk-form-group--full-width"
          },
          "classes": "govuk-radios--horizontal",
          "items": [
            {
              "checked": search_scope_preference == "all_courts",
              "value": "all_courts",
              "text": "All courts and tribunals",
              "hint": {
                "text": "Search all published judgments and decisions held within the Find Case Law service."
              }
            },
            {
              "checked": search_scope_preference == "higher_courts",
              "value": "higher_courts",
              "text": "Higher courts and tribunals",
              "hint": {
                "text": "Search judgments and decisions from courts and tribunals that establish legal precedent."
              }
            }
          ]
        }) }}
        <p>Use any search term including neutral citation, names and keywords</p>
        {{ search_input(label="Search by keyword or neutral citation", placeholder="Input your search term...", button_action=url("home") , button_label="Search") }}
        {% call search_input_footer() %}
          <div class="search-input__footer-info">
            {{ heading(tag="h4", content="Need to refine your search?") }}
            <p>Refine your search by selecting specific courts, tribunals, date ranges, judges and party names.</p>
          </div>
          {{ button(variant="link", content="Advanced search", element_type="button", attrs={"type": "submit", "formaction": url("home"), "value": "advanced_search", "name": "action"}) }}
        {% endcall %}
      {% endcall %}
    {% endcall %}
  {% endcall %}
  {% call content_container() %}
    <div>
      {{ heading(tag="h1", size="h2", content="About Find Case Law") }}
      <p>
        We offer free access to published judgments and decisions from courts and tribunals in England and Wales, plus UK-wide cases from the Supreme Court and Privy Council. These documents provide transparency into legal proceedings – a key principle of open justice – as well as insight into how case law is established and applied.
      </p>
      <p>
        <strong>Please note, our collection does not include every court judgment or tribunal decision.</strong>
      </p>
      {% call details(title="About our coverage and publication", variant="light") %}
        {% call card(variant="pale") %}
          <p><strong>Why are judgments and decisions published?</strong></p>
          <p>Publishing court judgments and tribunal decisions supports open justice and transparency by making legal proceedings and their outcomes accessible to the public. Some judgments and decisions also establish, develop or clarify the law, helping legal professionals and the public understand how the law is applied.</p>
          <p><strong>What does Find Case Law cover?</strong></p>
          <p>We provide free access to court judgments and tribunal decisions from England and Wales, plus UK-wide cases from the Supreme Court and Privy Council.</p>
          <p>Our collection includes the vast majority of judgments and decisions that courts have made publicly available in digital form. Coverage for most courts starts in the early 2000s, when digital records became standard. The Supreme Court was established in 2009.</p>
          <p>We're continuously expanding our collection as courts send us new judgments and decisions. However, not every court judgment or tribunal decision is available on Find Case Law. Some are delivered verbally and are never transcribed, while others may not be published or made available on the service.</p>
        {% endcall %}
      {% endcall %}
    </div>
    {% call grid() %}
      {% call card(title="New to case law?", url=url('understanding_case_law'), variant="image", image_url=static("images/HM-courts-and-tribunal-service-building-sign.jpg")) %}
        <p>Our Understanding case law section explains how courts work and how to read judgments.</p>
      {% endcall %}
      {% call card(title="Ready to search?", variant="image", url=url('search_and_browse'), image_url=static("images/modern-magnifying-glass.jpg")) %}
        <p>Use the search box above or browse by courts and tribunals to find specific cases</p>
      {% endcall %}
      {% call card(title="Need help?", url=url('help_and_support'), variant="image", image_url=static("images/person-working-on-a-laptop.jpg")) %}
        <p>Visit our Help and support section for search tips and guidance.</p>
      {% endcall %}
    {% endcall %}
    {% call heading(tag="h2", withoutMargins=True) %}
      Recently published judgments
    {% endcall %}
    {% call aside_container() %}
      {% call documents_table(headings=["Neutral citation", "Handed down"]) %}
        {% for judgment in judgments %}
          {% call document_table_body() %}
            {% call document_table_row() %}
              {% call document_table_cell(variant="details", colspan=3) %}
                {% call link(href=url("detail", judgment.slug)) %}
                  {{ judgment.name }}
                {% endcall %}
              {% endcall %}
            {% endcall %}
            {% call document_table_row() %}
              {% call document_table_cell(variant="details") %}
                {{ judgment.court.name }}
              {% endcall %}
              {% call document_table_cell(variant="text", label="Neutral citation") %}
                {{ judgment.neutral_citation | default("&mdash;", true) | safe }}
              {% endcall %}
              {% call document_table_cell(variant="text", label="Handed down") %}
                <time datetime="{{ judgment.date }}">{{ formatdate(judgment.date) }}</time>
              {% endcall %}
            {% endcall %}
          {% endcall %}
        {% endfor %}
      {% endcall %}
      {% call aside() %}
        {% call alert(size="sm") %}
          {{ heading(tag="h3", content="Business and Property Division") }}
          <p><strong>Changes from 1 October 2026</strong></p>
          <p>The <strong>Business and Property Division</strong> – a new division of the High Court – has replaced the <strong>Chancery Division</strong>.</p>
          <p>{{ link(href=url("court_or_tribunal", "ewhc/bp"), content="About the Business and Property Division") }}</p>
        {% endcall %}
        {% call card(variant="pale", title="Using judgments") %}
          {% call list(variant="bullets", padding="none", gap="md") %}
            {% call list_item() %}
              <strong>No licence is required</strong>
              to read, download or share judgments.
            {% endcall %}
            {% call list_item() %}
              <strong>A free licence may be required</strong>
              for commercial use or computational analysis.
            {% endcall %}
          {% endcall %}
          {% call list(gap="md") %}
            {% call list_item() %}
              {{ link(href=url("permissions_and_licensing") , content="Read the licensing guidance", class_name=trackable_class_name("Licence guidance card homepage")) }}
            {% endcall %}
            {% call list_item() %}
              {{ link(href=url("apply_for_a_licence") , content="Apply for a licence", class_name=trackable_class_name("Licence apply card homepage")) }}
            {% endcall %}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    {% endcall %}
    <div class="container--center">{{ button(href=url("search") , content="View all judgments") }}</div>
  {% endcall %}
{% endblock content %}
{% block javascript %}
  {{ vite_asset("javascript/stateful_details.ts") }}
{% endblock javascript %}

{% extends "layouts/standard_content.jinja" %}
{% from "components/divider.jinja" import divider %}
{% from "components/heading.jinja" import heading %}
{% from "components/contents.jinja" import contents %}
{% from "components/link.jinja" import link %}
{% from "components/tabs.jinja" import tabs %}
{% from "components/list.jinja" import list, list_item %}
{% from "includes/courts_and_tribunals_group.jinja" import courts_and_tribunals_group %}
{% block javascript %}
  <script type="module"
          defer
          src="{{ static('js/dist/govuk_tabs_extended.js') }}"></script>
{% endblock javascript %}
{% block mobile_article_title %}
  {% call heading() %}
    Types of courts in England and Wales
  {% endcall %}
{% endblock mobile_article_title %}
{% block desktop_article_title %}
  {% call heading() %}
    Types of courts in England and Wales
  {% endcall %}
{% endblock desktop_article_title %}
{% block article_navigation %}
  {% call contents(title="On this page") %}
    {% call heading(tag="h3") %}
      {% call link(href="#courts") %}
        <strong>Courts</strong>
      {% endcall %}
    {% endcall %}
    {% call list() %}
      {% for court in courts %}
        {% if court.display_heading %}
          {% call list_item() %}
            {% call link(href="#" ~ court.name|slugify) %}
              {{ court.name }} ({{ court.courts|length }})
            {% endcall %}
          {% endcall %}
        {% else %}
          {% for subcourt in court.courts %}
            {% call list_item() %}
              {% call link(href="#" ~ subcourt.name|slugify) %}
                {{ subcourt.name }}
              {% endcall %}
            {% endcall %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endcall %}
    {% call heading(tag="h3") %}
      {% call link(href="#tribunals") %}
        <strong>Tribunals</strong>
      {% endcall %}
    {% endcall %}
    {% call list() %}
      {% for tribunal in tribunals %}
        {% if tribunal.display_heading %}
          {% call list_item() %}
            {% call link(href="#" ~ tribunal.name|slugify) %}
              {{ tribunal.name }} ({{ tribunal.courts|length }})
            {% endcall %}
          {% endcall %}
        {% else %}
          {% for subcourt in tribunal.courts %}
            {% call list_item() %}
              {% call link(href="#" ~ subcourt.name|slugify) %}
                {{ subcourt.name }}
              {% endcall %}
            {% endcall %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endcall %}
  {% endcall %}
{% endblock article_navigation %}
{% block article_content %}
  <p>This page lists the courts and tribunals whose judgments and decisions are published on Find Case Law.</p>
  <p>For more about the justice system, visit the {% call link(href="https://www.judiciary.uk/structure-of-courts-and-tribunals-system/", attrs={"target": "_blank"}) %}judiciary website{% endcall %}. For older records, search the {% call link(href="https://discovery.nationalarchives.gov.uk/browse/r/h/C162", attrs={"target":"_blank"}) %}Discovery catalogue{% endcall %}.</p>
  {{ heading(tag="h2", content="Understanding date ranges") }}
  <p>The date range shows our earliest and most recent judgment from this court. Coverage within that range may not be complete — not every judgment is sent to us for publication.</p>
  {{ heading(tag="h2", content="Courts") }}
  {% for group in courts %}
    {{ courts_and_tribunals_group(group=group, type="court") }}
    {% if not loop.last %}{{ divider() }}{% endif %}
  {% endfor %}
  {{ heading(tag="h2", content="Tribunals") }}
  {% for group in tribunals %}
    {{ courts_and_tribunals_group(group=group, type="tribunal") }}
    {% if not loop.last %}{{ divider() }}{% endif %}
  {% endfor %}
{% endblock article_content %}

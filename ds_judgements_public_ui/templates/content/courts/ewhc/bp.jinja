{% from "components/link.jinja" import link %}
{% from "components/list.jinja" import list_item %}
{% from "components/heading.jinja" import heading %}
{%- set court_change_url = "https://www.judiciary.uk/the-lady-chief-justice-and-lord-chancellor-modernise-the-high-court-through-establishment-of-the-business-and-property-division/" -%}
{% macro historic_documents_content() %}
{% endmacro %}
{% macro court_noun_content() %}
  court
{% endmacro %}
{% macro contents_navigation() %}
  {% call list_item() %}
    {{ link(href="#coverage-on-find-case-law", content="Coverage on Find Case Law") }}
  {% endcall %}
  {% call list_item() %}
    {{ link(href="#recent-judgments", content="Recent judgments") }}
  {% endcall %}
  {% call list_item() %}
    {{ link(href="#search-this-court", content="Search this court") }}
  {% endcall %}
  {% call list_item() %}
    {{ link(href="#about", content="About " ~ court.name) }}
  {% endcall %}
  {% call list_item() %}
    {{ link(href="#questions-about-judgments-from-this-court", content="Questions about judgments from this court") }}
  {% endcall %}
{% endmacro %}
{% macro coverage_content() %}
  {{ heading(content="Coverage on Find Case Law", tag="h2") }}
  {% set court_date_range = param|get_court_date_range %}
  {% set court_start_year = param|get_court_start_year %}
  {% set court_documents_count = court|get_court_judgments_count|intcomma %}
  <p>
    <strong>Date range</strong> — {{ court_date_range }}
  </p>
  <p>
    <strong>What’s included</strong> — We currently hold {{ court_documents_count }} documents from {{ court_date_range }}.
  </p>
{% endmacro %}
{% macro understanding_content() %}
{% endmacro %}
{% macro description_content(start_year=None) %}
  <p>The Business and Property Division replaced the {{ link(content="Chancery Division", href=url("court_or_tribunal", "ewhc/ch")) }} on 1 October 2026. New judgments published from this date onwards can be found under the Business and Property Division. Earlier Chancery judgments remain available under the Chancery Division.</p>
  <p>Additionally, a number of specialist courts from the King’s Bench Division have moved over to the Business and Property Division. </p>
  <p>{{ link(content="Read more about the change on the Judiciary website", href=court_change_url) }}</p>
{% endmacro %}
{% macro about_content() %}
  {{ heading(content="About " ~ court.name, tag="h2", id="about") }}
  <p>
    The Business and Property Division is one of three divisions of the High Court. It handles a wide range of civil cases including business disputes, intellectual property and probate issues.
    On 1 October 2026 it replaced the {{ link(content="Chancery Division", href=url("court_or_tribunal", "ewhc/ch")) }} and took over a number specialist courts from the King’s Bench Division.
  </p>
  <p>It has various lists that deal with specialist issues such as the Business List, Insolvency and Companies List, Property, Trusts and Probate List, and Intellectual Property List (as well as its sub-lists, the Intellectual Property Enterprise Court and Patents Court). </p>
  <p>You can read more about the {{ link(content="decision to replace the Chancery Division with the Business and Property Division on the Judiciary website", href=court_change_url) }}.</p>
  <p>This court began to regularly transfer judgments to The National Archives in 2026.</p>
{% endmacro %}

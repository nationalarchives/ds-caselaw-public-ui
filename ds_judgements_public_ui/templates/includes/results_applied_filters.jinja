{% if query_params and query_params.items %}
  <h2 class="results-search-component__sub-header">Your search:</h2>
  <ul class="results-search-component__removable-options js-results-facets-applied-filters">
    {% if show_all_courts_label %}
      <li>
        <span class="results-search-component__option-tag">{{ ["all_courts"]|get_scope_label }}</span>
      </li>
    {% endif %}
    {% for key, value in query_params.items() %}
      {% if value %}
        {% if key|removable_filter_param %}
          <li>
            <a role="button"
               tabindex="0"
               draggable="false"
               class="results-search-component__removable-options-link {{ trackable_class_name('remove-filter-' ~ key) }}"
               aria-label="Remove {{ key|capfirst }} filter"
               href="{{ url('search') }}?{{ query_params|remove_query(key) }}">
              <span class="results-search-component__removable-options-key">{{ key|title }}:</span>
              <span class="results-search-component__removable-options-value">
                <span class="results-search-component__removable-options-value-text">{{ value }}</span>
              </span>
            </a>
          </li>
        {% elif (key == "scope" and "all_courts" not in value) %}
          {% set scope_label = value|get_scope_label %}
          {% if scope_label %}
            <li>
              <a role="button"
                 tabindex="0"
                 draggable="false"
                 class="results-search-component__removable-options-link {{ trackable_class_name('remove-filter-scope-' ~ value|join('-')|replace('_', '-')) }}"
                 aria-label="Remove {{ key|capfirst }} filter"
                 href="{{ url('search') }}?{{ query_params|remove_query(key) }}">
                <span class="results-search-component__removable-options-value">
                  <span class="results-search-component__removable-options-value-text">{{ scope_label }}</span>
                </span>
              </a>
            </li>
          {% endif %}
        {% elif key == "court" or key == "tribunal" %}
          {% if value|length > 1 %}
            <li>
              <a role="button"
                 tabindex="0"
                 draggable="false"
                 class="results-search-component__removable-options-link {{ trackable_class_name('remove-filter-courts') }}"
                 href="{{ url('search') }}?{{ query_params|remove_query(key) }}"
                 aria-label="Remove court and tribunal filters">
                <span class="results-search-component__removable-options-key">Courts and tribunals:</span>
                <span class="results-search-component__removable-options-value">
                  <span class="results-search-component__removable-options-value-text">{{ value|length }} selected</span>
                </span>
              </a>
            </li>
          {% else %}
            {% for court in value %}
              <li>
                <a role="button"
                   tabindex="0"
                   draggable="false"
                   class="results-search-component__removable-options-link {{ trackable_class_name('remove-filter-court-' ~ court|replace('/', '-')) }}"
                   href="{{ url('search') }}?{{ query_params|remove_court(court) }}"
                   aria-label="Remove {{ court|get_court_name }} filter"
                   title="{{ court|get_court_name }}">
                  <span class="results-search-component__removable-options-value">
                    <span class="results-search-component__removable-options-value-text">{{ court|get_court_name }}</span>
                  </span>
                </a>
              </li>
            {% endfor %}
          {% endif %}
        {% elif key == "from_date_2" %}
          <li>
            <a role="button"
               tabindex="0"
               draggable="false"
               class="results-search-component__removable-options-link {{ trackable_class_name('remove-filter-from-date') }}"
               aria-label="Remove from date filter"
               href="{{ url('search') }}?{{ query_params|remove_query('from') }}">
              <span class="results-search-component__removable-options-key">From:</span>
              <span class="results-search-component__removable-options-value">
                <span class="results-search-component__removable-options-value-text">
                  {{ query_params.from_date_0|replace_integer_with_day }}
                  {{ query_params.from_date_1|replace_integer_with_month }}
                  {{ value }}
                </span>
              </span>
            </a>
          </li>
        {% elif key == "to_date_2" %}
          <li>
            <a role="button"
               tabindex="0"
               draggable="false"
               class="results-search-component__removable-options-link {{ trackable_class_name('remove-filter-to-date') }}"
               aria-label="Remove to date filter"
               href="{{ url('search') }}?{{ query_params|remove_query('to') }}">
              <span class="results-search-component__removable-options-key">To:</span>
              <span class="results-search-component__removable-options-value">
                <span class="results-search-component__removable-options-value-text">
                  {{ query_params.to_date_0|replace_integer_with_day }}
                  {{ query_params.to_date_1|replace_integer_with_month }}
                  {{ value }}
                </span>
              </span>
            </a>
          </li>
        {% endif %}
      {% endif %}
    {% endfor %}
  </ul>
{% endif %}

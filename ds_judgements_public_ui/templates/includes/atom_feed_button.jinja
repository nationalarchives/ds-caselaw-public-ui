{% from "components/alert.jinja" import alert %}
<div class="results__result-atom-feed-button-container">
  <div class="results__result-atom-feed-button">
    <a href="{{ atom_feed_url }}">
      <img src="{{ static('fontawesome-svgs/rss.svg') }}"
           width="20"
           height="20"
           alt="" />
      Subscribe to these results
    </a>
    <div class="results__result-atom-feed-info" tabindex="0">
      <div class="results__result-atom-feed-info-icon"></div>
      <div class="results__result-atom-feed-info-text">
        {% call alert(size="sm") %}
          <p><strong>Stay up to date with this search</strong></p>
          <p>Subscribe to this search using an Atom feed with a compatible feed reader to receive updates when new judgments matching this search are published.</p>
        {% endcall %}
      </div>
    </div>
  </div>
</div>

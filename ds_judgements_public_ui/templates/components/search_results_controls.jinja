{% from "components/button.jinja" import button %}
{%- macro search_result_hidden_input(name=None, value=None) %}
  {%- if name in ["court", "tribunal"] -%}
    {%- for item in value -%}
      <input type="hidden" name="{{ name }}" value="{{ item }}" />
    {%- endfor -%}
  {%- elif name in ["from", "to"] -%}
    <input type="hidden"
           name="{{ name }}"
           value="{{ formatdate(value, '%Y-%b-%d') }}" />
  {%- else -%}
    <input type="hidden" name="{{ name }}" value="{{ value }}" />
  {%- endif -%}
{%- endmacro -%}
{%- macro search_results_controls(search_path=None, query_params=None, query=None, order=None, per_page=None, is_footer=False) -%}
  {%- if query_params and query_params.items -%}
    <div class="{{ component_class_names('result-controls', 'result-controls--footer' if is_footer) }}">
      <form method="get"
            data-search-results-controls
            action="{{ search_path }}"
            id="analytics-result-controls{{ "-footer" if is_footer else "" }}">
        {%- for name, value in query_params.items()
          if value and name not in ["order", "per_page"] -%}
          {{ search_result_hidden_input(name=name, value=value) }}
        {%- endfor -%}
        {%- if not is_footer -%}
          <div class="result-controls__item">
            <label for="order_by" class="result-controls__label">Order results by</label>
            <select class="result-controls__select" id="order_by" name="order">
              {%- if query -%}
                <option value="relevance"
                        {%- if order == "relevance" or order is none %} selected='selected' {%- endif %}>Most relevant</option>
              {%- endif -%}
              <option value="-date"
                      {%- if order == "-date" or (order is none and not query) %} selected='selected' {%- endif %}>Newest</option>
              <option value="date"{%- if order == "date" %} selected='selected'{%- endif %}>Oldest</option>
            </select>
            {{ button(variant="secondary", element_type="input", size="small", attrs={"type":"submit", "value":"Sort"}) }}
          </div>
        {%- endif -%}
        <div class="{{ component_class_names('result-controls__item', 'result-controls__item--desktop-only' if not is_footer) }}">
          <label for="per_page{{ "_footer" if is_footer else "" }}"
                 class="result-controls__label">Results per page</label>
          <select class="result-controls__select"
                  id="per_page{{ "_footer" if is_footer else "" }}"
                  name="per_page">
            <option value="10"
                    {%- if per_page == 10 or per_page is none %} selected='selected' {%- endif %}>10</option>
            <option value="25"{%- if per_page == 25 %} selected='selected'{%- endif %}>25</option>
            <option value="50"{%- if per_page == 50 %} selected='selected'{%- endif %}>50</option>
          </select>
          {{ button(variant="secondary", element_type="input", size="small", attrs={"type":"submit", "value":"Apply"}) }}
        </div>
      </form>
    </div>
  {%- endif -%}
{%- endmacro -%}
